# Copied into .env.local by `npm run setup:local`. Do not point these at the
# hosted project for day-to-day work — local data changes would be live.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_.
# OPENART_TOKEN is the access token from `openart login`
# (~/.openart/cli-credentials.json). Set the same values in Vercel
# (Production and Preview) or try-on cannot generate.
# If that file also has a refresh_token and client_id, set those too so the
# site keeps working after the access token expires.
OPENART_TOKEN=
OPENART_REFRESH_TOKEN=
OPENART_CLIENT_ID=
# Optional. Defaults to nano-banana-2.
OPENART_MODEL=
